import java.util.Scanner;

public class ex5 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Is Server Running? (true/false): ");
        boolean serverStatus = sc.nextBoolean();

        System.out.print("Is Database Connected? (true/false): ");
        boolean databaseStatus = sc.nextBoolean();

        if (!serverStatus) {
            System.out.println("Critical Error");
        } else if (!databaseStatus) {
            System.out.println("Database Error");
        } else {
            System.out.println("System Running Normally");
        }
    }
}

